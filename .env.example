# Antigravity Manager Configuration
# Web UI Port
PORT=8585

# Host username running agy (e.g. debian, ubuntu, chungnh, root)
HOST_USER=chungnh

# Host user's home directory (e.g. /home/chungnh or /root)
USER_HOME=/home/chungnh

# Path to agy binary (Leave empty to auto-detect in PATH or $USER_HOME/.local/bin/agy)
AGY_BIN=

# Name of the systemd user service managing agy remote-control
SYSTEMD_SERVICE=antigravity-cli-daemon.service

# Timezone
TZ=Asia/Ho_Chi_Minh
